---
import { getCollection } from "astro:content";
import Marketing from "../layouts/Marketing.astro";
import DemoHero from "../components/DemoHero.astro";
import DemoVideo from "../components/DemoVideo.astro";
import { demoSets } from "../components/demo/sets";

const description =
  "A free image and video poll. Upload 2 to 16, share one link, and people pick the better of two. You get every voter's top list and the overall ranking.";

// Every use page, in its own order.
const uses = (await getCollection("uses")).sort((a, b) => a.data.order - b.data.order);

const art = demoSets.thumbnails.items;
const sampleRanking = [
  { src: art[2].src, share: 100 },
  { src: art[5].src, share: 70 },
  { src: art[0].src, share: 45 },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Pairpoll",
    url: "https://pairpoll.com/",
    description: "A free poll for images and videos, ranked head to head.",
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Any",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author: { "@type": "Person", name: "Vladimir Terekhov" },
    sameAs: ["https://github.com/BuildShipGrowRepeat/pairpoll"],
  },
  { "@context": "https://schema.org", "@type": "WebSite", name: "Pairpoll", url: "https://pairpoll.com/" },
];
---
<Marketing title="Free image and video poll, ranked head to head | Pairpoll" description={description} jsonLd={jsonLd}>
  <DemoHero
    title={["Too many good options?", "Let people pick, two at a time."]}
    lead="A free poll for images and videos. Upload 2 to 16, send one link, and people pick the better of two until their favourites are clear."
    create="Create a free poll"
    tryLabel="Try the sample poll"
    note="Free and open source. Voters don't sign up."
  />

  <section class="section wrap" aria-labelledby="how-title">
    <div class="section-head">
      <h2 id="how-title">How it works</h2>
      <p class="lead">Choosing from a full grid is hard. Choosing between two is easy, so that is all a voter ever sees.</p>
    </div>
    <div class="how">
    <DemoVideo name="pairpoll-product-demo" label="Pairpoll product demo: making a poll, voting and reading the ranking" />
    <ol class="steps">
      <li class="step">
        <div class="step-art" aria-hidden="true">
          <div class="mini-grid">
            {art.map((item) => <span><span class="frame"><img src={item.src} alt="" loading="lazy" /></span></span>)}
            <span class="is-empty"><span class="frame"></span></span>
            <span class="is-empty"><span class="frame"></span></span>
          </div>
        </div>
        <h3>Put your options together</h3>
        <p>Add 2 to 16 images or videos and the question voters will see.</p>
      </li>
      <li class="step">
        <div class="step-art" aria-hidden="true"><span class="link-key">pairpoll.com/p/7hq2xk</span></div>
        <h3>Send one link</h3>
        <p>Share it with friends, your team or your audience. Each person picks the better of two, a few times over.</p>
      </li>
      <li class="step">
        <div class="step-art" aria-hidden="true">
          <ol class="mini-rank">
            {
              sampleRanking.map((row, i) => (
                <li>
                  {i + 1}
                  <span class="frame"><img src={row.src} alt="" loading="lazy" /></span>
                  <i style={`--share: ${row.share}%`} />
                </li>
              ))
            }
          </ol>
        </div>
        <h3>See the favourites</h3>
        <p>You get each person's top list and an overall ranking.</p>
      </li>
    </ol>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="uses-title">
    <div class="section-head">
      <h2 id="uses-title">What you can rank</h2>
      <p class="lead">Anything people can judge by looking. Images or videos, one kind per poll.</p>
    </div>
    <ul class="uses">
      {
        uses.map((use) => (
          <li>
            <a class="use" href={`/for/${use.id}`}>
              <b>{use.data.name}</b>
              <span>{use.data.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="facts-title">
    <div class="section-head">
      <h2 id="facts-title">Good to know</h2>
    </div>
    <dl class="facts">
      <div><dt>Voters don't sign up</dt><dd>They open the link, type a name and start picking.</dd></div>
      <div><dt>Top 1, 3 or 5</dt><dd>You choose how long each voter's top list is.</dd></div>
      <div><dt>Videos can play once</dt><dd>Turn this on and each video plays to the end before a voter can pick.</dd></div>
      <div><dt>Up to 200 voters</dt><dd>That is the limit for one poll. Each browser votes once.</dd></div>
    </dl>
  </section>

  <div class="section wrap">
    <section class="agents" aria-labelledby="agents-title">
      <div>
        <h2 id="agents-title">Your AI agent can run the poll</h2>
        <p class="lead">
          Ask your assistant to set up a poll, send you the link and read the results.
        </p>
        <ul class="clients" aria-label="Works with">
          <li>Claude</li>
          <li>ChatGPT</li>
          <li>Claude Code</li>
          <li>Codex</li>
          <li>Cursor</li>
        </ul>
        <p><a href="/docs/agents"><b>Read the agent docs</b></a></p>
      </div>
      <div class="agents-media">
        <DemoVideo name="pairpoll-agent-demo" label="Pairpoll agent demo: an AI agent creates a poll and reads the results" />
        <pre class="terminal" aria-label="Example command">pairpoll create ./thumbnails \
  --question "Which thumbnail would you click?" \
  --top 3 --open</pre>
      </div>
      <dl class="agents-list">
          <div>
            <dt>MCP server</dt>
            <dd>
              Add <code>pairpoll.com/mcp</code> to Claude or ChatGPT as a custom connector and sign in. Claude Code, Codex and
              Cursor connect with an API key. You add the files in a browser page your assistant links to.
            </dd>
          </div>
          <div>
            <dt>CLI</dt>
            <dd>The <code>pairpoll</code> command makes a poll from a folder of files in one step.</dd>
          </div>
          <div>
            <dt>API</dt>
            <dd>REST endpoints under <code>/api/v1</code>, with an API key you create in your account.</dd>
          </div>
      </dl>
    </section>
  </div>

  <section class="section wrap open" aria-labelledby="free-title">
    <h2 id="free-title">Free and open source</h2>
    <p class="lead">
      Pairpoll is free to use, and its <a href="https://github.com/BuildShipGrowRepeat/pairpoll">code is on GitHub</a>.
      Polls, files and votes are deleted 30 days after a poll is created. <a href="/about">About Pairpoll</a>
    </p>
  </section>

  <div class="wrap">
    <section class="cta" aria-labelledby="cta-title">
      <div>
        <h2 id="cta-title">Got a few options? Find the favourite.</h2>
        <p>It's free, and your voters don't need an account.</p>
      </div>
      <a class="btn btn--primary btn--lg" href="/app/new">Create a poll</a>
    </section>
  </div>
</Marketing>

<style>
  /* How it works */
  /* The video is a child component, so scoped selectors need :global to reach it. */
  .how {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .steps {
    display: grid;
    gap: var(--s-6) clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    counter-increment: step;
  }

  .step-art {
    display: grid;
    align-content: center;
    min-height: 12rem;
    padding: 1.25rem;
    border-radius: 24px;
    background: var(--well);
  }

  .step h3 {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: 1.25rem;
    font-size: var(--text-xl);
  }

  .step h3::before {
    content: counter(step);
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--page);
    font-size: 1.125rem;
  }

  .step p {
    max-width: 26em;
    margin-top: var(--s-2);
    color: var(--ink-soft);
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .mini-grid > span {
    display: block;
    padding: 3px;
    border-radius: 9px;
    background: var(--surface);
    box-shadow: 0 3px 0 var(--edge);
  }

  .mini-grid .frame {
    border-radius: 6px;
  }

  .mini-grid .is-empty {
    background: none;
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .mini-grid .is-empty .frame {
    background: none;
  }

  .link-key {
    justify-self: center;
    max-width: 100%;
    padding: 0.85rem 1.25rem;
    border-radius: var(--r-control);
    background: var(--surface);
    box-shadow: 0 4px 0 var(--edge);
    font-weight: var(--weight-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-rank {
    display: grid;
    gap: 6px;
    justify-self: center;
    width: min(100%, 19rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mini-rank li {
    display: grid;
    grid-template-columns: 1.25rem 3.5rem 1fr;
    align-items: center;
    gap: 0.6rem;
    padding: 5px 0.75rem 5px 0.5rem;
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 3px 0 var(--edge);
    font-weight: var(--weight-display);
  }

  .mini-rank li:first-child {
    background: var(--yellow);
    box-shadow: 0 3px 0 var(--yellow-deep);
    color: var(--on-yellow);
  }

  .mini-rank .frame {
    border-radius: 5px;
  }

  .mini-rank i {
    display: block;
    width: var(--share);
    height: 6px;
    border-radius: 3px;
    background: var(--blue);
  }

  .mini-rank li:first-child i {
    background: var(--on-yellow);
  }

  /* What you can rank: a plain index, each name is a link. */
  .uses {
    display: grid;
    column-gap: clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .use {
    display: block;
    height: 100%;
    padding-block: var(--s-4) 1.25rem;
    border-top: 3px solid var(--ink);
    text-decoration: none;
  }

  .use b {
    display: block;
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: transform var(--quick) var(--ease);
  }

  .use span {
    display: block;
    margin-top: 0.35rem;
    color: var(--ink-soft);
    line-height: 1.35;
  }

  .use:hover b {
    transform: translateX(0.4rem);
  }

  /* Good to know */
  .facts {
    display: grid;
    gap: var(--s-5) clamp(1.5rem, 3vw, 3rem);
  }

  .facts dt {
    font-size: 1.3125rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .facts dd {
    max-width: 24em;
    margin-top: 0.35rem;
    color: var(--ink-soft);
  }

  /* Agents: one dark panel in both themes, because the reader here is often a developer. */
  .agents {
    display: grid;
    gap: var(--s-6) clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding: clamp(1.5rem, 4vw, 4rem);
    border-radius: 32px;
    background: var(--panel);
    color: var(--panel-ink);
  }

  .agents > * {
    min-width: 0;
  }

  .agents-media {
    display: grid;
    gap: var(--s-4);
  }

  .agents :global(.demo-video) {
    border-color: var(--panel-line);
    background: var(--panel);
  }

  .agents .lead {
    margin-block: 1.25rem;
    color: var(--panel-soft);
  }

  .agents a:hover {
    color: var(--yellow);
  }

  .agents :focus-visible {
    outline-color: var(--yellow);
  }

  .clients {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0 0 var(--s-5);
    padding: 0;
    list-style: none;
  }

  .clients li {
    padding: 0.3rem 0.85rem;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 2px var(--panel-line);
    font-weight: var(--weight-ui);
  }

  .terminal {
    padding: var(--s-4) 1.125rem;
    border-radius: 18px;
    background: var(--terminal);
    box-shadow: inset 0 0 0 2px var(--panel-line);
    color: #e9eaff;
    font: 500 0.9375rem/1.6 var(--mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .agents-list {
    display: grid;
    grid-column: 1 / -1;
  }

  .agents-list > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--s-4);
    padding-block: 0.9rem;
    border-bottom: 2px solid var(--panel-line);
  }

  .agents-list > div:last-child {
    border-bottom: 0;
  }

  .agents-list dt {
    font-weight: 800;
  }

  .agents-list dd {
    color: var(--panel-soft);
  }

  .agents-list code {
    color: var(--panel-ink);
  }

  /* Free and open source, then the last call to action on the winner's yellow. */
  .open .lead {
    margin-top: var(--s-4);
  }

  .cta {
    display: grid;
    gap: var(--s-5);
    align-items: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.75rem, 4vw, 4rem);
    border-radius: 32px;
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .cta h2 {
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4.25rem);
  }

  .cta p {
    margin-top: var(--s-3);
    font-size: 1.1875rem;
  }

  .cta :focus-visible {
    outline-color: var(--on-yellow);
  }

  @media (min-width: 40rem) {
    .uses,
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .uses {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .agents {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }

    /* The three ways in, side by side under the intro and the video. */
    .agents-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .agents-list > div {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0.35rem;
      border-top: 2px solid var(--panel-line);
      border-bottom: 0;
    }

    .cta {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  /* Wide screens: the three steps stacked on the left (text, then picture), the video on the right. */
  @media (min-width: 80rem) {
    .how {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
    }

    .how :global(.demo-video) {
      order: 1;
      max-width: none;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }

    .step {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 11rem;
      column-gap: 1.25rem;
    }

    .step-art {
      grid-column: 2;
      grid-row: 1 / span 2;
      min-height: 7rem;
      padding: 0.75rem;
      border-radius: 18px;
    }

    .step h3 {
      align-self: end;
      margin-top: 0;
    }

    .step p {
      align-self: start;
    }

    .mini-grid {
      gap: 5px;
    }

    .link-key {
      padding: 0.5rem 0.7rem;
      font-size: 0.8125rem;
    }

    .mini-rank li {
      grid-template-columns: 0.9rem 2.25rem 1fr;
      gap: 0.4rem;
      padding: 4px 0.5rem 4px 0.4rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 39.99rem) {
    .step-art {
      min-height: 9.5rem;
    }

    .agents,
    .cta {
      border-radius: 24px;
    }

    .agents-list > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
