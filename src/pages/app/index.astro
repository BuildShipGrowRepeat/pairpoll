---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";

export const prerender = false;

const row = await env.DB.prepare("SELECT value FROM app_meta WHERE key = 'schema'").first<{ value: string }>();
---
<Base title="Your polls - Pairpoll">
  <h1>Your polls</h1>
  <p>Server-rendered placeholder. Database schema: <span id="schema">{row?.value ?? "missing"}</span></p>
</Base>
