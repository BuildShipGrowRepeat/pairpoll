---
import { env } from "cloudflare:workers";
import Voter from "../../layouts/Voter.astro";
import PickLoop from "../../components/PickLoop.astro";
import { ServerError } from "../../server/errors";
import { getSharedResults } from "../../server/results";
import "../../styles/app.css";
import "../../styles/voter.css";

export const prerender = false;

// The read-only results page the creator can turn on. Items are numbered, never named by file.
let results: Awaited<ReturnType<typeof getSharedResults>> | null = null;
try {
  results = await getSharedResults(env.DB, Astro.params.code ?? "");
} catch (error) {
  if (!(error instanceof ServerError) || error.status !== 404) throw error;
}
if (!results) Astro.response.status = 404;

const plural = (count: number, one: string) => `${count} ${count === 1 ? one : `${one}s`}`;
const items = new Map(results?.items.map((item) => [item.id, item]));
const media = (id: string) => {
  const item = items.get(id)!;
  return { src: `/api/v1/media/${item.posterId ?? item.mediaId}`, video: results!.kind === "video" && !item.posterId, label: item.label };
};
---
<Voter title={results ? `Results: ${results.question}` : "Results not found | Pairpoll"}>
  {
    results ? (
      <div class="shared stack">
        <header>
          <h1 class="shared-title">{results.question}</h1>
          <p class="page-head-meta">
            <span class:list={["badge", results.status === "open" ? "badge--live" : "badge--done"]}>
              {results.status === "open" ? "Voting open" : "Voting closed"}
            </span>
            <span>{plural(results.finished, "voter")} finished</span>
          </p>
        </header>

        <section aria-labelledby="ranking-title">
          <h2 class="section-title" id="ranking-title">Overall ranking</h2>
          {results.finished === 0 ? (
            <p class="empty-line">No one has finished voting yet. Check back later.</p>
          ) : (
            <ol class="rank">
              {results.ranking.map((entry) => {
                const item = media(entry.id);
                return (
                  <li class:list={["rank-item", !entry.points && "is-zero"]}>
                    <span class="rank-place">
                      {entry.rank}
                      {entry.rank === 1 && entry.points > 0 && <PickLoop class="rank-loop" />}
                    </span>
                    <span class="frame rank-thumb">
                      {item.video ? <video src={`${item.src}#t=0.1`} preload="metadata" muted playsinline /> : <img src={item.src} alt="" loading="lazy" />}
                    </span>
                    <span class="rank-name">{item.label}</span>
                    <span class="rank-meta">
                      <span class="rank-points">{plural(entry.points, "point")}</span>
                      {entry.firsts > 0 && plural(entry.firsts, "first place")}
                    </span>
                  </li>
                );
              })}
            </ol>
          )}
          {results.finished > 0 && (
            <p class="shared-note">
              Each voter's top {results.topSize === 1 ? "pick scores 1 point" : `${results.topSize} score points: first place ${results.topSize}, then one less for each place`}.
            </p>
          )}
        </section>

        {results.runs && results.runs.length > 0 && (
          <section aria-labelledby="voters-title">
            <h2 class="section-title" id="voters-title">Voters</h2>
            <ul class="voter-list">
              {results.runs.map((run) => (
                <li class="voter-row">
                  <p class="voter-name">{run.name}</p>
                  <ol class="voter-top" aria-label={`${run.name}'s top list`}>
                    {(run.ranking ?? []).map((id, index) => {
                      const item = media(id);
                      return (
                        <li>
                          <span>{index + 1}</span>
                          <span class="frame" title={item.label}>
                            {item.video ? <video src={`${item.src}#t=0.1`} preload="metadata" muted playsinline /> : <img src={item.src} alt={item.label} loading="lazy" />}
                          </span>
                        </li>
                      );
                    })}
                  </ol>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    ) : (
      <section class="status">
        <h1>These results aren't shared</h1>
        <p>The link may be wrong, or the person who made the poll turned the results page off.</p>
      </section>
    )
  }
</Voter>

<style>
  .shared {
    gap: var(--s-7);
  }

  .shared-title {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3rem);
    overflow-wrap: anywhere;
    margin-bottom: var(--s-3);
  }

  .shared .voter-list {
    margin-top: var(--s-4);
  }

  .shared-note {
    margin-top: var(--s-4);
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }
</style>
