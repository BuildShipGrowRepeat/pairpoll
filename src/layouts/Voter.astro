---
import Base from "./Base.astro";
import Logo from "../components/Logo.astro";

// Voter page shell: noindex, no site navigation, one narrow column so the pair gets the screen.
// The page fills the `report` slot with its "Report this poll" link.
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<Base title={title} noindex description="Pick the better of two until your top list is settled.">
  <main id="main" class="voter-main">
    <slot />
  </main>
  <footer class="voter-footer">
    <span>Made with <Logo /></span>
    <slot name="report" />
  </footer>
</Base>

<style>
  .voter-main {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
    padding: var(--s-5) var(--gutter) var(--s-7);
  }

  .voter-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
    padding: var(--s-4) var(--gutter) var(--s-5);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .voter-footer > span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .voter-footer :global(.logo-word) {
    font-size: 1.05rem;
  }

  .voter-footer :global(.logo svg) {
    width: 22px;
    height: 22px;
  }
</style>
