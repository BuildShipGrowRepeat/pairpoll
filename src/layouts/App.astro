---
import Base from "./Base.astro";
import Logo from "../components/Logo.astro";
import Consent from "../components/Consent.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

// Creator app shell: always noindex. Pages put their title row and content in the slot.
interface Props {
  title: string;
}
const { title } = Astro.props;
const links = [
  { href: "/app", label: "Polls" },
  { href: "/app/keys", label: "API keys" },
  { href: "/app/account", label: "Account" },
];
const path = Astro.url.pathname;
const current = (href: string) => (href === "/app" ? path === "/app" || path.startsWith("/app/polls") : path.startsWith(href));
---
<Base title={`${title} | Pairpoll`} noindex>
  <header class="app-header">
    <div class="wrap app-header-row">
      <Logo href="/app" />
      <nav aria-label="App">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </header>
  <main id="main" class="wrap app-main">
    <slot />
  </main>
  <Consent />
</Base>

<style>
  .app-header {
    padding-block: var(--s-4);
  }

  .app-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }

  .app-header-row > :global(.logo) {
    margin-right: auto;
  }

  .app-header ul {
    display: flex;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .app-header a:not(.logo) {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-3);
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
  }

  .app-header a:not(.logo):hover {
    background: var(--well);
    color: var(--ink);
  }

  .app-header a[aria-current="page"] {
    background: var(--well);
  }

  /* Phones: the app links get their own row under the logo. */
  @media (max-width: 39.99rem) {
    .app-header nav {
      order: 3;
      width: 100%;
      margin-left: calc(-1 * var(--s-3));
    }
  }

  .app-main {
    padding-block: var(--s-5) var(--s-8);
  }
</style>
