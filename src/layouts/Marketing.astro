---
import type { ComponentProps } from "astro/types";
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Consent from "../components/Consent.astro";

// Public pages: home, uses, alternatives, guides, about, legal.
// Server-rendered pages that know the visitor is signed in pass `signedIn`.
type Props = ComponentProps<typeof Base> & { signedIn?: boolean };
const { signedIn = false, ...base } = Astro.props;
---
<Base {...base}>
  <Header signedIn={signedIn} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <Consent />
</Base>
