---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import { PUBLIC_CF_BEACON_TOKEN } from "astro:env/client";

// Document shell with technical SEO. Every public page passes its own title and description.
// Pages that must stay out of search (polls, the creator app, errors) set noindex.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "A free poll for images and videos, ranked head to head.",
  noindex = false,
  ogType = "website",
  ogImage = "/og.png",
  ogImageAlt = "The Pairpoll logo: two cards, the front one marked with a yellow dot.",
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL("https://pairpoll.com");
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/").replace(/(.)\/$/, "$1");
const canonical = new URL(path, site).href;
const image = new URL(ogImage, site).href;
// Escape "<" so content can never close the script tag.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The theme chosen with the switch, applied before first paint. Without it the device decides. */}
    <script is:inline>
      try {
        const theme = localStorage.getItem("pairpoll-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {
        // No storage (private window): follow the device.
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f5f6fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f20" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/gabarito-latin-wght.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Pairpoll" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {
      PUBLIC_CF_BEACON_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_BEACON_TOKEN })}
        />
      )
    }
  </body>
</html>
