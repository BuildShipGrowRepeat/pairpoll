---
import type { HTMLAttributes } from "astro/types";

type Props = (HTMLAttributes<"a"> & HTMLAttributes<"button">) & {
  variant?: "primary" | "secondary" | "quiet" | "danger";
  size?: "sm" | "md" | "lg";
  block?: boolean;
};

const { variant = "primary", size = "md", block = false, href, type = "button", class: className, ...rest } = Astro.props;
const classes = ["btn", `btn--${variant}`, size !== "md" && `btn--${size}`, block && "btn--block", className];
---
{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
