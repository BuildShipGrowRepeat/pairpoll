---
import DuelCard from "../DuelCard.astro";
import { demoSets, type DemoSetName } from "./sets";
import { replay } from "../../lib/knockout";

// A playable sample poll: pick the better of two until the top 3 is settled. Nothing is stored.
interface Props {
  set?: DemoSetName;
  question?: string;
  id?: string;
}
const { set = "thumbnails", question, id = "demo" } = Astro.props;
const demo = demoSets[set];
const ids = demo.items.map((item) => item.id);
// The page renders the first pair of a fixed draw; "Start again" in the browser draws a new one.
const first = replay(ids, 1, [], 3);
const byId = new Map(demo.items.map((item) => [item.id, item]));
const [a, b] = (first.next ?? [ids[0], ids[1]]).map((itemId) => byId.get(itemId)!);
// Square and tall pictures: narrow the pair so each card stays about as tall as a 16:9 one.
const [w, h] = demo.ratio.split("/").map(Number);
const pairStyle = `max-width: ${(2 * 18 * w) / h + 3}rem`;
---
<div class="pair-demo" id={id} data-demo data-items={JSON.stringify(demo.items)}>
  <div class="pair-demo-head">
    <p class="pair-demo-question">{question ?? demo.question}</p>
    <p class="pair-demo-count">
      <span class="pegs" aria-hidden="true">
        {Array.from({ length: first.total }, (_, i) => <span class:list={["peg", i === 0 && "is-now"]} />)}
      </span>
      <span data-count aria-live="polite">Pick 1 of {first.total}</span>
    </p>
  </div>

  <div class:list={["duel", { "duel--portrait": w < h }]} data-stage style={pairStyle}>
    <div class="duel-pair">
      <DuelCard id={a.id} src={a.src} alt={a.name} pickLabel={`Pick ${a.name}`} ratio={demo.ratio} />
      <span class="duel-or" aria-hidden="true">or</span>
      <DuelCard id={b.id} src={b.src} alt={b.name} pickLabel={`Pick ${b.name}`} ratio={demo.ratio} />
    </div>
  </div>

  <div class="pair-demo-result" data-result hidden>
    <h2 tabindex="-1" data-result-title>Your top 3</h2>
    <ol class="rank" data-rank></ol>
    <div class="actions">
      <a class="btn btn--primary" href="/app/new">Create your own poll</a>
      <button type="button" class="btn btn--quiet" data-restart>Start over</button>
    </div>
  </div>

  <p class="pair-demo-note">Sample pictures. Nothing you pick is saved.</p>

  <template data-rank-template>
    <li class="rank-item">
      <span class="rank-place" data-place></span>
      <span class="frame rank-thumb"><img alt="" /></span>
      <span class="rank-name" data-name></span>
      <span class="rank-meta"></span>
    </li>
  </template>
</div>

<style>
  /* A tray on the well tone; a compact pair: slimmer edges, smaller sticker and "or". */
  .pair-demo {
    --depth: 5px;
    --r-tile: 16px;
    --r-frame: 10px;
    padding: clamp(1rem, 2.5vw, 2rem);
    border-radius: var(--r-panel);
    background: var(--well);
  }

  .pair-demo :global(.duel-face) {
    padding: 6px;
  }

  .pair-demo :global(.duel-or) {
    --or: 36px;
    font-size: 0.875rem;
    box-shadow: 0 0 0 4px var(--well);
  }

  .pair-demo :global(.sticker) {
    width: 42px;
    height: 42px;
  }

  .pair-demo :global(.sticker svg) {
    width: 22px;
    height: 22px;
  }

  .pair-demo-head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }

  .pair-demo-question {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: var(--weight-display);
    letter-spacing: -0.025em;
    line-height: 1;
    text-wrap: balance;
  }

  .pair-demo-count {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--ink-soft);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .pair-demo .duel {
    margin-inline: auto;
  }

  .pair-demo-result {
    display: grid;
    gap: var(--s-4);
  }

  .pair-demo-result h2 {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
  }

  .pair-demo-result h2:focus {
    outline: none;
  }

  .pair-demo-note {
    margin-top: var(--s-4);
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }
</style>

<script>
  import { replay } from "../../lib/knockout";
  import type { DemoItem } from "./sets";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const items: DemoItem[] = JSON.parse(root.dataset.items ?? "[]");
    const byId = new Map(items.map((item) => [item.id, item]));
    const ids = items.map((item) => item.id);
    const cards = [...root.querySelectorAll<HTMLButtonElement>("[data-stage] .duel-card")];
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const pegs = [...root.querySelectorAll<HTMLElement>(".peg")];
    const result = root.querySelector<HTMLElement>("[data-result]")!;
    const list = root.querySelector<HTMLOListElement>("[data-rank]")!;
    const template = root.querySelector<HTMLTemplateElement>("[data-rank-template]")!;
    let picks: string[] = [];
    let seed = 1;
    let busy = false;

    for (const item of items) new Image().src = item.src;

    const show = () => {
      const state = replay(ids, seed, picks, 3);
      busy = false;
      const index = state.matches.length;
      pegs.forEach((peg, i) => {
        peg.classList.toggle("is-now", i === index);
        peg.classList.toggle("is-done", i < index);
        peg.classList.remove("is-popped");
      });
      if (state.next) {
        state.next.forEach((itemId, i) => {
          const item = byId.get(itemId)!;
          const card = cards[i];
          card.dataset.item = item.id;
          card.setAttribute("aria-label", `Pick ${item.name}`);
          const img = card.querySelector("img")!;
          img.src = item.src;
          img.alt = item.name;
          card.classList.remove("is-picked", "is-passed");
        });
        count.textContent = `Pick ${index + 1} of ${state.total}`;
        stage.hidden = false;
        result.hidden = true;
        // The new pair slides in; restart the animation on the same cards.
        stage.classList.remove("is-dealt");
        void stage.offsetWidth;
        if (index > 0) stage.classList.add("is-dealt");
        return;
      }
      list.replaceChildren(
        ...(state.ranking ?? []).map((itemId, i) => {
          const item = byId.get(itemId)!;
          const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
          row.querySelector("[data-place]")!.textContent = String(i + 1);
          if (i === 0) row.classList.add("is-first");
          row.querySelector("img")!.src = item.src;
          row.querySelector("[data-name]")!.textContent = item.name;
          return row;
        }),
      );
      count.textContent = "Done";
      stage.hidden = true;
      result.hidden = false;
      result.querySelector<HTMLElement>("[data-result-title]")!.focus();
    };

    for (const card of cards) {
      card.addEventListener("click", () => {
        if (busy) return;
        busy = true;
        for (const other of cards) {
          other.classList.add(other === card ? "is-picked" : "is-passed");
        }
        const peg = pegs[picks.length];
        peg?.classList.replace("is-now", "is-popped");
        picks = [...picks, card.dataset.item!];
        // Long enough to see the sticker land; the next pair is usable about 260 ms after the pick.
        window.setTimeout(show, reduceMotion.matches ? 120 : 260);
      });
    }

    root.querySelector("[data-restart]")!.addEventListener("click", () => {
      picks = [];
      seed = crypto.getRandomValues(new Uint32Array(1))[0];
      show();
      cards[0].focus();
    });
  }
</script>
