---
import { demoSets } from "../demo/sets";

interface Props {
  kind: string;
}

const { kind } = Astro.props;
const designs = demoSets.designs.items;
const cuts = demoSets["video-cuts"].items;
---

{kind === "pickfu" && (
  <div class="picture-panels">
    <div class="picture-panel">
      <header><b>PickFu</b><span>Paid panel</span></header>
      <div class="picture-people panel-people">
        {Array.from({ length: 6 }, () => <svg class="person" viewBox="0 0 40 40"><circle cx="20" cy="12" r="6" /><path d="M8 34c1-9 5-13 12-13s11 4 12 13" /></svg>)}
      </div>
      <span class="picture-key money">$</span>
    </div>
    <div class="picture-panel is-pairpoll">
      <header><b>Pairpoll</b><span>Your audience</span></header>
      <span class="picture-key link-key">pairpoll.com/p/7hq2xk</span>
      <div class="picture-people own-people">
        {Array.from({ length: 4 }, () => <svg class="person" viewBox="0 0 40 40"><circle cx="20" cy="12" r="6" /><path d="M8 34c1-9 5-13 12-13s11 4 12 13" /></svg>)}
      </div>
    </div>
  </div>
)}

{kind === "lyssna" && (
  <div class="picture-panels count-panels">
    <div class="picture-panel">
      <header><b>Lyssna</b><span>Up to 6 designs</span></header>
      <div class="count-grid six-options">{Array.from({ length: 6 }, (_, index) => <span>{index + 1}</span>)}</div>
    </div>
    <div class="picture-panel is-pairpoll">
      <header><b>Pairpoll</b><span>2–16 images or videos</span></header>
      <div class="count-grid sixteen-options">{Array.from({ length: 16 }, (_, index) => <span>{index + 1}</span>)}</div>
    </div>
  </div>
)}

{kind === "opinionx" && (
  <div class="picture-panels">
    <div class="picture-panel score-panel">
      <header><b>OpinionX</b><span>Win rate, 0–100</span></header>
      <div class="score-bars"><i></i><i></i><i></i></div>
    </div>
    <div class="picture-panel is-pairpoll top-list-panel">
      <header><b>Pairpoll</b><span>Top lists add up</span></header>
      <div class="two-lists">
        <ol><li>A <b>3</b></li><li>B <b>2</b></li><li>C <b>1</b></li></ol>
        <ol><li>B <b>3</b></li><li>A <b>2</b></li><li>C <b>1</b></li></ol>
      </div>
    </div>
  </div>
)}

{kind === "pollunit" && (
  <div class="picture-panels">
    <div class="picture-panel route-panel">
      <header><b>PollUnit</b><span>Random pairs</span></header>
      <div class="random-pairs"><span>A · C</span><span>B · D</span><span>A · D</span></div>
      <strong>ELO rating</strong>
    </div>
    <div class="picture-panel is-pairpoll route-panel">
      <header><b>Pairpoll</b><span>One knockout per voter</span></header>
      <div class="mini-bracket"><span>A</span><span>B</span><i></i><strong>A</strong></div>
      <strong>Top 1, 3 or 5</strong>
    </div>
  </div>
)}

{kind === "strawpoll" && (
  <div class="picture-panels">
    <div class="picture-panel classic-panel">
      <header><b>StrawPoll</b><span>All options at once</span></header>
      <div class="choice-list"><span>A</span><span>B</span><span>C</span><span>D</span></div>
      <div class="result-bars"><i></i><i></i><i></i><i></i></div>
    </div>
    <div class="picture-panel is-pairpoll pair-result-panel">
      <header><b>Pairpoll</b><span>Two at a time</span></header>
      <div class="media-pair">
        {[designs[1], designs[3]].map((item, index) => <span class:list={[index === 0 && "selected"]}><span class="frame"><img src={item.src} alt="" loading="lazy" /></span></span>)}
      </div>
      <ol class="mini-top"><li>1 <b>A</b></li><li>2 <b>B</b></li><li>3 <b>C</b></li></ol>
    </div>
  </div>
)}

{kind === "uxtweak" && (
  <div class="picture-panels free-panels">
    <div class="picture-panel">
      <header><b>UXtweak free</b><span>2 images</span></header>
      <div class="media-pair compact-pair">
        {[designs[0], designs[2]].map((item) => <span><span class="frame"><img src={item.src} alt="" loading="lazy" /></span></span>)}
      </div>
      <strong>3 responses per study</strong>
    </div>
    <div class="picture-panel is-pairpoll">
      <header><b>Pairpoll</b><span>Up to 16 images or videos</span></header>
      <div class="mixed-media">
        {[cuts[0], cuts[2]].map((item) => (
          <span class="video-frame"><span class="frame"><img src={item.src} alt="" loading="lazy" /></span><svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z" /></svg></span>
        ))}
      </div>
      <strong>Up to 200 voters</strong>
    </div>
  </div>
)}

<style>
  .panel-people {
    display: grid;
    grid-template-columns: repeat(3, 2.25rem);
    margin-top: var(--s-5);
  }

  .money {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 2.75rem;
    font-size: var(--text-lg);
    text-align: center;
  }

  .link-key {
    margin: var(--s-5) auto 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .own-people {
    margin-top: var(--s-4);
  }

  .own-people :global(.person) {
    box-shadow: 0 3px 0 var(--blue-deep), 0 0 0 2px var(--blue);
  }

  .count-panels {
    max-width: 50rem;
  }

  .count-grid {
    display: grid;
    gap: 6px;
    margin-top: var(--s-5);
  }

  .six-options {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .sixteen-options {
    grid-template-columns: repeat(8, minmax(0, 1fr));
  }

  .count-grid span {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 7px;
    background: var(--well);
    box-shadow: 0 3px 0 var(--edge);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
  }

  .is-pairpoll .count-grid span {
    background: var(--surface);
    box-shadow: 0 3px 0 var(--blue-deep);
  }

  .score-panel,
  .top-list-panel,
  .route-panel,
  .classic-panel,
  .pair-result-panel,
  .free-panels .picture-panel {
    display: grid;
    align-content: space-between;
    gap: var(--s-5);
  }

  .score-bars,
  .result-bars {
    display: grid;
    gap: var(--s-3);
  }

  .score-bars i,
  .result-bars i {
    display: block;
    height: 0.75rem;
    border-radius: var(--r-pill);
    background: var(--blue);
  }

  .score-bars i:nth-child(2),
  .result-bars i:nth-child(2) {
    width: 74%;
  }

  .score-bars i:nth-child(3),
  .result-bars i:nth-child(3) {
    width: 46%;
  }

  .result-bars i:nth-child(4) {
    width: 28%;
  }

  .two-lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .two-lists ol,
  .mini-top {
    display: grid;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .two-lists li,
  .mini-top li {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    padding: 0.45rem 0.6rem;
    border-radius: var(--r-control);
    background: var(--well);
    font-weight: var(--weight-ui);
  }

  .two-lists li:first-child,
  .mini-top li:first-child {
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .random-pairs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
  }

  .random-pairs span,
  .route-panel > strong,
  .free-panels strong {
    padding: 0.55rem 0.7rem;
    border-radius: var(--r-control);
    background: var(--well);
    font-size: var(--text-sm);
    text-align: center;
  }

  .mini-bracket {
    display: grid;
    grid-template-columns: repeat(2, 1fr) 1.5rem 1fr;
    align-items: center;
    gap: var(--s-2);
  }

  .mini-bracket span,
  .mini-bracket strong {
    display: grid;
    place-items: center;
    min-height: 3.5rem;
    border-radius: var(--r-control);
    background: var(--well);
    box-shadow: 0 3px 0 var(--edge);
  }

  .mini-bracket i {
    height: 3px;
    background: var(--line);
  }

  .mini-bracket strong {
    background: var(--yellow);
    box-shadow: 0 3px 0 var(--yellow-deep);
    color: var(--on-yellow);
  }

  .choice-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .choice-list span {
    display: grid;
    place-items: center;
    min-height: 3.5rem;
    border-radius: var(--r-control);
    background: var(--well);
    box-shadow: 0 3px 0 var(--edge);
    font-weight: var(--weight-display);
  }

  .media-pair,
  .mixed-media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .media-pair > span,
  .mixed-media > span {
    position: relative;
    padding: 5px;
    border-radius: var(--r-tile);
    background: var(--surface);
    box-shadow: 0 4px 0 var(--edge);
  }

  .media-pair .selected {
    box-shadow: 0 4px 0 var(--yellow-deep), 0 0 0 3px var(--yellow);
  }

  .compact-pair {
    max-width: 18rem;
    margin-inline: auto;
  }

  .mixed-media {
    max-width: 20rem;
    margin-inline: auto;
  }

  .video-frame svg {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 2.5rem;
    padding: 0.45rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 3px 0 var(--edge);
    fill: var(--ink);
  }

  @media (max-width: 39.99rem) {
    .sixteen-options {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
