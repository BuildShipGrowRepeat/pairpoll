---
import AboutPicture from "./AboutPicture.astro";
import AlternativePicture from "./AlternativePicture.astro";
import GuidePicture from "./GuidePicture.astro";
import UsePicture from "./UsePicture.astro";

export type PagePictureKind =
  | "about"
  | "pairwise"
  | "voters"
  | "ads"
  | "thumbnails"
  | "preference-ab"
  | "paired-method"
  | "maxdiff"
  | "pickfu"
  | "lyssna"
  | "opinionx"
  | "pollunit"
  | "strawpoll"
  | "uxtweak"
  | "agents"
  | "pairwise-tool";

interface Props {
  kind: PagePictureKind;
}

const { kind } = Astro.props;
const guideKinds = ["pairwise", "voters", "ads", "thumbnails", "preference-ab", "paired-method", "maxdiff"];
const alternativeKinds = ["pickfu", "lyssna", "opinionx", "pollunit", "strawpoll", "uxtweak"];
---

<div class:list={["coded-picture", `coded-picture--${kind}`]} aria-hidden="true">
  {kind === "about" && <AboutPicture />}
  {guideKinds.includes(kind) && <GuidePicture kind={kind} />}
  {alternativeKinds.includes(kind) && <AlternativePicture kind={kind} />}
  {(kind === "agents" || kind === "pairwise-tool") && <UsePicture kind={kind} />}
</div>

<style>
  .coded-picture {
    width: 100%;
    min-width: 0;
    padding: clamp(1rem, 4vw, 2.5rem);
    overflow: hidden;
    border-radius: var(--r-panel);
    background: var(--well);
  }

  :global(:where(.coded-picture .picture-flow)) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(2rem, 7vw, 5rem) minmax(0, 1fr);
    align-items: center;
    max-width: 58rem;
    margin-inline: auto;
  }

  :global(:where(.coded-picture .picture-join)) {
    display: block;
    width: calc(100% - 0.75rem);
    height: 3px;
    margin-inline: auto;
    border-radius: var(--r-pill);
    background: var(--line);
  }

  :global(:where(.coded-picture .picture-panels)) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    max-width: 56rem;
    margin-inline: auto;
  }

  :global(:where(.coded-picture .picture-panel)) {
    position: relative;
    min-width: 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border-radius: var(--r-tile);
    background: var(--surface);
    box-shadow: 0 5px 0 var(--edge);
  }

  :global(:where(.coded-picture .picture-panel.is-pairpoll)) {
    box-shadow: 0 5px 0 var(--blue-deep), 0 0 0 3px var(--blue);
  }

  :global(:where(.coded-picture .picture-panel > header)) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-3);
  }

  :global(:where(.coded-picture .picture-panel > header b)) {
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
  }

  :global(:where(.coded-picture .picture-panel > header span)) {
    color: var(--ink-soft);
    font-weight: var(--weight-ui);
  }

  :global(:where(.coded-picture .picture-key)) {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: var(--r-control);
    background: var(--surface);
    box-shadow: 0 4px 0 var(--edge);
    font-weight: var(--weight-ui);
  }

  :global(:where(.coded-picture .picture-people)) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
  }

  :global(:where(.coded-picture .person)) {
    display: block;
    width: 2.25rem;
    padding: 5px;
    overflow: visible;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 3px 0 var(--edge);
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 3;
    stroke-linecap: round;
  }

  :global(:where(.coded-picture .picture-rank)) {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(:where(.coded-picture .picture-rank li)) {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
    padding: 0.55rem 0.75rem;
    border-radius: var(--r-control);
    background: var(--surface);
    box-shadow: 0 3px 0 var(--edge);
  }

  :global(:where(.coded-picture .picture-rank li:first-child)) {
    background: var(--yellow);
    box-shadow: 0 3px 0 var(--yellow-deep);
    color: var(--on-yellow);
  }

  :global(:where(.coded-picture .picture-rank b)) {
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    text-align: center;
  }

  :global(:where(.coded-picture .picture-rank span)) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: var(--weight-ui);
  }

  @media (max-width: 39.99rem) {
    .coded-picture :global(.picture-flow),
    .coded-picture :global(.picture-panels) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }

    .coded-picture :global(.picture-join) {
      width: 3px;
      height: 1.75rem;
    }
  }
</style>
