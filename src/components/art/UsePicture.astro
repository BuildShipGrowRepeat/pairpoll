---
import { demoSets } from "../demo/sets";

interface Props {
  kind: "agents" | "pairwise-tool";
}

const { kind } = Astro.props;
const photos = demoSets.photos.items;
---

{kind === "agents" && (
  <div class="agent-flow">
    <div class="assistant-card">
      <svg viewBox="0 0 40 40"><circle cx="20" cy="12" r="6" /><path d="M8 34c1-9 5-13 12-13s11 4 12 13" /></svg>
      <b>Assistant</b>
    </div>
    <i></i>
    <span class="picture-key">Upload link</span>
    <i></i>
    <span class="picture-key link-key">pairpoll.com/p/7hq2xk</span>
    <i></i>
    <ol class="picture-rank agent-rank"><li><b>1</b><span>First</span></li><li><b>2</b><span>Second</span></li><li><b>3</b><span>Third</span></li></ol>
  </div>
)}

{kind === "pairwise-tool" && (
  <div class="picture-panels pick-count-panels">
    <div class="picture-panel is-pairpoll bracket-panel">
      <header><b>Knockout</b><span>16 items</span></header>
      <div class="small-bracket">
        <span class="frame"><img src={photos[0].src} alt="" loading="lazy" /></span>
        <span class="frame"><img src={photos[1].src} alt="" loading="lazy" /></span>
        <i></i>
        <span class="frame winner"><img src={photos[0].src} alt="" loading="lazy" /></span>
      </div>
      <strong>15 picks for top 1</strong>
    </div>
    <div class="picture-panel every-pair-panel">
      <header><b>Every pair</b><span>16 items</span></header>
      <div class="pair-cloud">
        {[
          "A · B", "A · C", "A · D", "A · E", "A · F", "B · C",
          "B · D", "B · E", "B · F", "C · D", "C · E", "C · F",
        ].map((pair) => <span>{pair}</span>)}
      </div>
      <strong>120 picks</strong>
    </div>
  </div>
)}

<style>
  .agent-flow {
    display: grid;
    grid-template-columns: auto minmax(1rem, 1fr) auto minmax(1rem, 1fr) auto minmax(1rem, 1fr) minmax(10rem, 1.2fr);
    align-items: center;
    gap: var(--s-3);
    max-width: 64rem;
    margin-inline: auto;
  }

  .agent-flow > i {
    height: 3px;
    border-radius: var(--r-pill);
    background: var(--line);
  }

  .assistant-card {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    padding: 0.8rem;
    border-radius: var(--r-tile);
    background: var(--surface);
    box-shadow: 0 4px 0 var(--edge);
  }

  .assistant-card svg {
    width: 2.5rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .link-key {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .agent-rank li {
    grid-template-columns: 1.25rem minmax(0, 1fr);
  }

  .pick-count-panels {
    max-width: 50rem;
  }

  .bracket-panel,
  .every-pair-panel {
    display: grid;
    align-content: space-between;
    gap: var(--s-5);
  }

  .bracket-panel > strong,
  .every-pair-panel > strong {
    font-size: var(--text-xl);
    text-align: center;
  }

  .small-bracket {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) 2rem minmax(0, 1fr);
    align-items: center;
    gap: var(--s-2);
  }

  .small-bracket .frame {
    border: 4px solid var(--surface);
    border-radius: var(--r-frame);
    box-shadow: 0 3px 0 var(--edge);
  }

  .small-bracket i {
    height: 3px;
    background: var(--line);
  }

  .small-bracket .winner {
    box-shadow: 0 3px 0 var(--yellow-deep), 0 0 0 3px var(--yellow);
  }

  .pair-cloud {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 5px;
  }

  .pair-cloud span {
    padding: 0.35rem;
    border-radius: 7px;
    background: var(--well);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    text-align: center;
  }

  @media (max-width: 49.99rem) {
    .agent-flow {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: var(--s-3);
    }

    .agent-flow > i {
      width: 3px;
      height: 1rem;
    }

    .agent-flow > * {
      max-width: 100%;
    }

    .agent-rank {
      width: min(100%, 18rem);
    }
  }
</style>
