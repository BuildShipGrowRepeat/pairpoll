---
import Sticker from "../Sticker.astro";
---

<div class="picture-flow origin-flow">
  <div class="video-grid">
    {Array.from({ length: 9 }, (_, index) => (
      <span class:list={[index === 4 && "finalist"]}>
        <svg class="play" viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z" /></svg>
      </span>
    ))}
  </div>
  <span class="picture-join"></span>
  <div class="origin-pair">
    <span class="origin-tile picked">
      <svg class="play" viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z" /></svg>
      <Sticker />
    </span>
    <span class="origin-tile passed"><svg class="play" viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z" /></svg></span>
  </div>
</div>

<style>
  .origin-flow {
    max-width: 50rem;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.4rem, 1.4vw, 0.7rem);
  }

  .video-grid > span,
  .origin-tile {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-frame);
    background: var(--surface);
    box-shadow: 0 3px 0 var(--edge);
  }

  .video-grid .finalist {
    box-shadow: 0 3px 0 var(--blue-deep), 0 0 0 3px var(--blue);
  }

  .play {
    width: 1.75rem;
    fill: var(--ink-soft);
  }

  .origin-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .origin-tile {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .origin-tile.picked {
    box-shadow: 0 3px 0 var(--yellow-deep), 0 0 0 3px var(--yellow);
  }

  .origin-tile.passed {
    opacity: 0.4;
  }

  .origin-tile :global(.sticker) {
    top: -14px;
    right: -10px;
    opacity: 1;
    animation: none;
  }
</style>
