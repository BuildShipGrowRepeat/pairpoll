---
// Light, dark or system. System follows the device and is the default; light or dark is kept in
// localStorage and applied before first paint by the inline script in Base.astro.
// One per page (in the header). The menu is a popover: the browser closes it on Escape and on a click outside.
const choices = [
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
  { value: "system", label: "System" },
];
---
<button type="button" class="theme-toggle" popovertarget="theme-menu" aria-label="Theme" title="Theme">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>
  </svg>
</button>
<div id="theme-menu" class="theme-menu" popover aria-label="Theme">
  {
    choices.map((choice) => (
      <button type="button" data-theme-choice={choice.value} aria-pressed="false">
        {choice.label}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    ))
  }
</div>

<script>
  const root = document.documentElement;
  const menu = document.querySelector<HTMLElement>("#theme-menu");
  const toggle = document.querySelector<HTMLButtonElement>('[popovertarget="theme-menu"]');

  if (menu && toggle) {
    const choices = menu.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");
    const mark = () => {
      const current = root.dataset.theme ?? "system";
      for (const choice of choices) choice.setAttribute("aria-pressed", String(choice.dataset.themeChoice === current));
    };

    // The open menu sits in the top layer; place it under the button, right edges aligned.
    menu.addEventListener("beforetoggle", (event) => {
      if ((event as ToggleEvent).newState !== "open") return;
      const box = toggle.getBoundingClientRect();
      menu.style.top = `${box.bottom + window.scrollY + 8}px`;
      menu.style.right = `${root.clientWidth - box.right}px`;
    });

    for (const choice of choices) {
      choice.addEventListener("click", () => {
        const theme = choice.dataset.themeChoice;
        if (theme === "light" || theme === "dark") root.dataset.theme = theme;
        else delete root.dataset.theme;
        try {
          if (root.dataset.theme) localStorage.setItem("pairpoll-theme", root.dataset.theme);
          else localStorage.removeItem("pairpoll-theme");
        } catch {
          // Private windows may have no storage; the choice then lasts for this page only.
        }
        mark();
        menu.hidePopover();
      });
    }
    mark();
  }
</script>
