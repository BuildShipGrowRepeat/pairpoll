---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  signedIn?: boolean;
}
const { signedIn = false } = Astro.props;
const account = signedIn ? { href: "/app", label: "Your polls" } : { href: "/signin", label: "Sign in" };

const links = [
  { href: "/for", label: "Uses" },
  { href: "/guides", label: "Guides" },
  { href: "/docs", label: "Docs" },
];
const path = Astro.url.pathname;
const current = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="site-header">
  <div class="wrap site-header-row">
    <Logo />
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href={account.href}>{account.label}</a></li>
      </ul>
    </nav>
    <ThemeToggle />
    <a class="btn btn--primary btn--sm" href="/app/new">Create a poll</a>
    <details class="site-menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </summary>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href={account.href}>{account.label}</a></li>
      </ul>
    </details>
  </div>
</header>

<style>
  .site-header {
    padding-block: var(--s-4);
  }

  .site-header-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .site-header-row > :global(.logo) {
    margin-right: auto;
  }

  .site-header-row > :global(.btn) {
    margin-bottom: 4px;
  }

  .site-nav ul,
  .site-menu ul {
    display: flex;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a,
  .site-menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-3);
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-menu a:hover {
    background: var(--well);
    color: var(--ink);
  }

  .site-nav a[aria-current="page"],
  .site-menu a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .site-menu {
    display: none;
    position: relative;
  }

  .site-menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -0.5rem;
    border-radius: 50%;
    list-style: none;
    cursor: pointer;
  }

  .site-menu summary::-webkit-details-marker {
    display: none;
  }

  .site-menu summary:hover,
  .site-menu[open] summary {
    background: var(--well);
  }

  .site-menu ul {
    position: absolute;
    right: -0.5rem;
    top: calc(100% + var(--s-2));
    z-index: 5;
    flex-direction: column;
    min-width: 12rem;
    padding: var(--s-2);
    border-radius: var(--r-tile);
    background: var(--surface);
    box-shadow:
      0 4px 0 var(--edge),
      0 18px 32px -16px var(--shade);
  }

  .site-menu a {
    padding: var(--s-3);
  }

  @media (max-width: 47.99rem) {
    .site-header-row {
      gap: var(--s-2);
    }

    .site-nav {
      display: none;
    }

    .site-menu {
      display: block;
    }
  }

  @media (max-width: 23.99rem) {
    .site-header-row > :global(.btn) {
      padding-inline: 0.75rem;
    }
  }
</style>
