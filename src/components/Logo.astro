---
import Mark from "./Mark.astro";

interface Props {
  href?: string;
}
const { href = "/" } = Astro.props;
---
<a class="logo" href={href} aria-label="Pairpoll home">
  <Mark />
  <span class="logo-word" aria-hidden="true">Pairpoll</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  .logo:hover {
    color: var(--ink);
  }

  .logo-word {
    font-size: 1.5rem;
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  @media (max-width: 39.99rem) {
    .logo-word {
      font-size: 1.375rem;
    }
  }
</style>
