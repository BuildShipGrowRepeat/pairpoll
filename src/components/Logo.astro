---
import Mark from "./Mark.astro";

interface Props {
  href?: string;
}
const { href = "/" } = Astro.props;
---
<a class="logo" href={href} aria-label="Pairpoll home">
  <Mark size={30} />
  <span class="logo-word" aria-hidden="true">pairpoll</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--ink);
  }

  .logo-word {
    font-size: 1.375rem;
    font-weight: var(--weight-display);
    letter-spacing: -0.035em;
    line-height: 1;
    padding-bottom: 0.1em;
  }
</style>
