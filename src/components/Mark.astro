---
// The Pairpoll mark: a card leaning back, the front card on its blue edge, and a yellow dot for the pick.
// Colours come from the theme through the classes below; public/icon.svg is the fixed-colour copy.
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className } = Astro.props;
---
<svg class:list={["mark", className]} width={size} height={size} viewBox="0 0 34 34" aria-hidden="true" focusable="false">
  <rect class="mark-back" x="2" y="8" width="17" height="20" rx="5" transform="rotate(-10 10 18)"></rect>
  <rect class="mark-edge" x="14" y="8" width="17" height="20" rx="5"></rect>
  <rect class="mark-front" x="14" y="5" width="17" height="20" rx="5"></rect>
  <circle class="mark-dot" cx="28" cy="8" r="5.5" stroke-width="2"></circle>
</svg>

<style>
  .mark {
    flex: none;
  }

  .mark-back {
    fill: var(--line);
  }

  .mark-edge {
    fill: var(--blue-deep);
  }

  .mark-front {
    fill: var(--blue);
  }

  .mark-dot {
    fill: var(--yellow);
    stroke: var(--page);
  }
</style>
