{
  "name": "pairpoll-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run types && astro dev",
    "build": "npm run types && astro build",
    "preview": "astro preview",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run types && astro check",
    "lint": "eslint .",
    "test": "npm run types && vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
