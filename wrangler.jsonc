{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pairpoll",
  // Custom entry: Astro's fetch handler plus the cron handler.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "57e11fb96b1643c79b0352cca086987b"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pairpoll",
      "database_id": "72db0581-ad79-4d02-9f79-d304fc15a560",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pairpoll-media"
    }
  ],
  "triggers": {
    // Daily 30-day cleanup.
    "crons": ["0 3 * * *"]
  },
  "vars": {
    // Public site key of the invisible Turnstile widget. Local dev overrides it from .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGIYYC3sGM26hmFd"
  },
  "send_email": [{ "name": "EMAIL" }],
  "routes": [
    { "pattern": "pairpoll.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true },
  "secrets": {
    // Set with `wrangler secret put`; locally from .dev.vars.
    // OWNER_EMAILS: comma-separated service-owner accounts (a space disables the owner routes).
    "required": ["TURNSTILE_SECRET_KEY", "OWNER_EMAILS"]
  }
}
